      "render_controllers": [
        { "controller.render.player.first_person_spectator": "v.is_first_person && q.is_spectator" },
        { "controller.render.player.third_person_spectator": "!v.is_first_person && !v.map_face_icon && q.is_spectator" },
        { "controller.render.player.first_person": "v.is_first_person && !q.is_spectator" },
        { "controller.render.player.third_person": "!v.is_first_person && !v.map_face_icon && !q.is_spectator" },
        { "controller.render.player.map": "v.map_face_icon" },

        { "controller.render.player.armor.attachable_bones": "(q.has_armor_slot(0) || (q.has_armor_slot(1) && (q.armor_texture_slot(1) != 5)) || q.has_armor_slot(3)) && !q.is_spectator" },
        { "controller.render.player.armor.attachable_bones_elytra": "(q.armor_texture_slot(1) == 5) && !q.is_spectator" },
        { "controller.render.player.armor.attachable_bones_leggings": "q.has_armor_slot(2) && !q.is_spectator" },
        { "controller.render.player.armor.helmet": "!v.is_first_person && !v.map_face_icon && (v.hurt_time > 0.0) && q.has_armor_slot(0) && !q.is_spectator && !q.is_invisible && !q.is_emoting" },
        { "controller.render.player.armor.chestplate": "!v.is_first_person && !v.map_face_icon && (v.hurt_time > 0.0) && q.has_armor_slot(1) && !q.is_spectator && !q.is_invisible && !q.is_emoting" },
        { "controller.render.player.armor.leggings": "!v.is_first_person && !v.map_face_icon && (v.hurt_time > 0.0) && q.has_armor_slot(2) && !q.is_spectator && !q.is_invisible && !q.is_emoting" },
        { "controller.render.player.armor.boots": "!v.is_first_person && !v.map_face_icon && (v.hurt_time > 0.0) && q.has_armor_slot(3) && !q.is_spectator && !q.is_invisible && !q.is_emoting" },
        { "controller.render.player.fire": "!v.is_first_person && !v.map_face_icon && q.is_alive && q.is_on_fire && !q.is_spectator" }
      ],
      "enable_attachables": true
    }
  }
